{% extends "common/template.njk" %}

{% block page_content %}
  <h1 class="govuk-heading-l">{{ title }}</h1>

  <p class="govuk-body-m">{{informationLine1}}</p>

  <h2 class="govuk-heading-s">{{informationLine2}}</h2>
  
  <p class="govuk-body-m">{{informationLine3}}</p>
  <p class="govuk-body-m">{{informationLine4}}</p>
  
  <h2 class="govuk-heading-s">{{courtsAndTribunalsHeader}}</h2>
  
  <p class="govuk-body-m">{{telephoneLabel}}</p>
  <p class="govuk-body-m">{{telephoneNumber}}</p>
  <p class="govuk-body-m">{{timesOpen}}</p>
  <p class="govuk-body-m">{{timesClosed}}</p>
  <p class="govuk-body-m">
    <a
      class="govuk-link"
      target="_blank"
      rel="noopener noreferrer"
      href="https://www.gov.uk/call-charges">
      {{callChargesLink}}
    </a>
  </p>
  
  <h2 class="govuk-heading-s">{{onlineFormsHeader}}</h2>
  
  <p class="govuk-body-m">{{onlineFormsInformation}}</p>
  <p class="govuk-body-m">{{informationLine4}}</p>
  
  <h2 class="govuk-heading-s">{{weAreGroup}}</h2>
  
  <p class="govuk-body-m">{{weAreGroupEmailLabel}}</p>
  <p class="govuk-body">
    <a href="mailto:support@wearegroup.com">support@wearegroup.com</a>
  </p>
  <p class="govuk-body-m">{{weAreGroupEmail}}</p>
  <p class="govuk-body-m">{{weAreGroupTelephoneLabel}}</p>
  <p class="govuk-body-m">{{weAreGroupTelephone}}</p>
  <p class="govuk-body-m">{{weAreGroupTimesOpenAndClosed}}</p>
  <p class="govuk-body-m">{{weAreGroupText}}</p>
  <p class="govuk-body-m">
    <a
      class="govuk-link"
      target="_blank"
      rel="noopener noreferrer"
      href="https://www.gov.uk/call-charges">
      {{callChargesLink}}
    </a>
  </p>

{% endblock %}
