{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "../../../common/fileupload/macro.njk" import fileUpload %}
{%- from "moj/components/multi-file-upload/macro.njk" import mojMultiFileUpload -%}

{% extends "common/page.njk" %}
{% block page_content %}

{% if FileErrors.length > 0 %}
{{ govukErrorSummary({
  titleText: "There is a problem",
  errorList: FileErrors
}) }}
{%endif%}

  <h1 class="govuk-heading-xl">{{title}} </h1>
  <p class="govuk-body-l">{{ uploadGuidance1 }}</p>
  <p class="govuk-body">{{ uploadGuidance2 }}</p>
  <p class="govuk-body">{{ uploadGuidance3 }}</p>

{% set uploadReqTest = ""%}
{% for item in uploadHelpBullet %}
    {% set uploadReqTest = uploadReqTest + "<li>" + item + "</li>"%}
{% endfor %}
{% set requirementTest = "<ol class='govuk-list govuk-list--number'>" + uploadReqTest + "</ol>" %}

{{ govukDetails({
  summaryText: uploadHelp,
  text: requirementTest  | safe
}) }}
    {% for error in sessionErrors %}
      {%- if  error.propertyName === 'document'  %}<div class="govuk-form-group--error">  {% endif %}
      {% endfor %}
    {% for error in sessionErrors %}
      {%- if  error.propertyName === 'document'  %}
      {%- if  error.errorType === 'required'  %}
          <span class="govuk-error-message" id="co-file-upload-required-error">
      <span class="govuk-visually-hidden">Error: </span>{{errors['document'].required}}</span>
      {% endif %}
      {%- if  error.errorType === 'multipleFiles'  %}
      <span class="govuk-error-message" id="co-file-upload-multiple-error">
      <span class="govuk-visually-hidden">Error: </span>{{errors['document'].multipleFiles}}</span>
      {% endif %}
      {% endif %}
      {% endfor %}
   <form method="post" enctype="multipart/form-data">
         {% set uploadHtml %}
           {{ fileUpload({
             id: "documents",
             name: "documents",
             classes: "moj-multi-file-upload__input",
             label: {
               text: "Upload a file",
               classes: "govuk-label--m"
             },
             attributes: { multiple: "" },
             errorMessage: errorMessage
           }) }}

           {{ govukButton({
             text: "Upload file",
             classes: "govuk-button--secondary moj-multi-file-upload__button"
           }) }}
         {% endset %}

         {{ mojMultiFileUpload({
           uploadedFiles: {
             heading: { text: "Files added" },
             items: uploadedFiles
           },
           uploadHtml: uploadHtml
         }) }}
       </form>
  {% for error in sessionErrors %}
  {%- if  error.propertyName === 'document'  %}</div>  {% endif %}
  {% endfor %}

{% endblock %}
