{% from "govuk/components/table/macro.njk" import govukTable %}
{% extends "../../common/dashboard-page.njk" %}

{% block backLink %}{% endblock %}

{% block content %}
  {% block page_content %}
    <h1 class="govuk-heading-l govuk-!-margin-bottom-5">
      <span class="govuk-caption-l">{{additionalData.user.fullname}}</span>
      {{title}}
    </h1>

    <h3 class="govuk-heading-s">{{sectionTitle}}</h3>

    <ul class="govuk-list">
      <li>
        <p class="govuk-body">{{dashboardDescriptionText}}</p>
      </li>
      <li>
        <h2 class="govuk-heading-m">{{applyCAHeading}}</h2>
      </li>
      <li>
        <p class="govuk-body">{{courtDecisionText}}</p>
      </li>
      {% if c100Rebuild %}
        <li>
          <a class="govuk-link" href="/task-list/applicant">{{newChildArrangementsLinkText}}</a>
        </li>
      {% endif %}
      <li>
        <h2 class="govuk-heading-m">{{linkCaseHeading}}</h2>
      </li>
      <li>
        <a class="govuk-link" href="/pin-activation/enter-pin">{{pinActivateLinkText}}</a>
      </li>
    </ul>

    <a class="govuk-link" href="https://www.gov.uk/injunction-domestic-violence">{{newFamilyInjunctionLinkText}}</a>

    {% for caseState, tab in tabs %}
      <div class="dashboard-card govuk-!-margin-top-8" id="{{tab.id}}">
        <h2 class="govuk-heading-m dashboard-card__title">{{tab.heading}}</h2>

        {% if tab.body %}
          <p class="govuk-body">{{tab.body | safe}}</p>
        {% endif %}

        {% if tab.rows.length %}
          {{ govukTable({
              head: tab.head,
              rows: tab.rows
            }) }}
        {% endif %}
      </div>
    {% endfor %}
  {% endblock %}
{% endblock %}
