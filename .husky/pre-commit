#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

set -e

# Use the repository's Yarn release so terminal and IDE commits run the same checks.
node .yarn/releases/yarn-4.6.0.cjs run lint --quiet

# Disable watch mode so commits never wait for keyboard input.
node .yarn/releases/yarn-4.6.0.cjs run test --watch=false --runInBand
